# Database (Prisma Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/novel_translator?sslmode=require"

# DeepSeek API (server only — never expose to client)
DEEPSEEK_API_KEY="sk-..."

# iron-session cookie encryption (min 32 characters)
SESSION_PASSWORD="change-me-to-a-long-random-string-32+"

# Required for registration — share this code only with friends
INVITE_CODE="your-secret-invite-code"
